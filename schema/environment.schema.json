{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofach90/platform-live/blob/main/schema/environment.schema.json",
  "title": "Environment (platform/<env>.yaml)",
  "description": "Registry of one environment: settings and the team projects the platform manages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "environment", "platformProject", "region", "stateBucket", "layers", "projects"],
  "properties": {
    "apiVersion": { "const": "platform.demo/v1" },
    "kind": { "const": "Environment" },
    "environment": { "enum": ["dev"] },
    "platformProject": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$" },
    "region": { "type": "string", "pattern": "^[a-z]+-[a-z]+[0-9]+$" },
    "stateBucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$" },
    "layers": {
      "description": "Layer code this environment runs: one repo and one released tag per layer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "workload"],
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "version"],
          "properties": {
            "source": {
              "description": "a GitHub repository as owner/name",
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "version": {
              "description": "a released tag such as v1.2.3 (never a branch)",
              "type": "string",
              "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "version"],
          "properties": {
            "source": {
              "description": "a GitHub repository as owner/name",
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "version": {
              "description": "a released tag such as v1.2.3 (never a branch)",
              "type": "string",
              "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        }
      }
    },
    "projects": {
      "description": "Key = project key used by workloads. Renaming a key destroys and recreates its resources.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,28}[a-z0-9]$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "team", "network"],
        "properties": {
          "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$" },
          "team": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$" },
          "network": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cidr"],
            "properties": {
              "cidr": { "type": "string", "pattern": "^10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.0/2[0-8]$" }
            }
          }
        }
      }
    }
  }
}
